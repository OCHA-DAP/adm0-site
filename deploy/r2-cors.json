{
  "rules": [
    {
      "allowed": {
        "origins": ["https://ocha-dap.github.io", "http://localhost:4321"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-Match"]
      },
      "exposeHeaders": ["ETag", "Content-Range", "Content-Length"],
      "maxAgeSeconds": 3600
    }
  ]
}
